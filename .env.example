# Copy this file to .env and fill in your Alpaca PAPER keys.
# Get them from the Alpaca dashboard: switch to Paper Trading, then API Keys > Generate.
# Never commit your real .env file.

ALPACA_API_KEY=your_paper_key_id
ALPACA_SECRET_KEY=your_paper_secret_key

# The bot refuses to start unless this is "true". There is no live mode.
ALPACA_PAPER=true

# What to watch, comma separated.
SYMBOLS=SPY,QQQ,AAPL

# Strategy: hold while the fast average is above the slow average (trading days).
FAST_WINDOW=20
SLOW_WINDOW=50

# Guardrails
MAX_POSITION_PCT=0.10      # max 10% of equity per position
MAX_ORDERS_PER_RUN=3       # never send more than this many orders in one run
KILL_SWITCH_FILE=STOP      # create a file named STOP to block all orders
JOURNAL_PATH=journal.csv   # every decision is appended here
